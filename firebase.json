{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".github/**",
      ".git/**",
      "**/.git/**",
      "**/*.bat",
      "**/*.md",
      "**/*.sql",
      "**/node_modules/**",
      "lab-members-android/**",
      "scratch/**",
      "*.apk",
      "**/*.apk"
    ],
    "redirects": [
      {
        "source": "/chat-prototype.html",
        "destination": "/chat-prototype_1.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/chat-prototype_1.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
